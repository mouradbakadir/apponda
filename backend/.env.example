# --- Stockage des documents ---------------------------------------------
# "local" : disque du conteneur (défaut en développement).
# "r2"    : Cloudflare R2, indispensable en production sur Railway où le
#           disque d'un conteneur est effacé à chaque redéploiement.
# Laisser vide : déduit automatiquement, "r2" si les 4 variables R2_* sont
# renseignées, "local" sinon.
STORAGE_DRIVER=
STORAGE_PATH=storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
